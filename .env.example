# Local: postgres://paperclip:paperclip@localhost:5432/paperclip
# Railway: paste the URL from Railway Postgres (add ?sslmode=require if TLS is required).
DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
#
# Paperclip loads env from ~/.paperclip/instances/default/.env (next to config.json), not only this file.
# After editing DATABASE_URL here, copy that line into the instance .env, or run onboarding from a clean instance.
PORT=3100
# In dev, `pnpm dev` sets PAPERCLIP_UI_DEV_MIDDLEWARE=true so the UI still loads. For API-only, use false.
SERVE_UI=false
